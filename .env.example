# GEMINI_API_KEY: Required for Gemini AI API calls (in AI Studio, Cloud Run, Vercel, and Netlify Environment Variables).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional client-side key for static deployments
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
